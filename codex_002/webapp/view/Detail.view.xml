<mvc:View
  controllerName="request.management.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns="sap.m">
  <Page title="{= ${detail>/isNew} ? '新規申請' : '申請明細' }" showNavButton="true" navButtonPress=".onNavBack">
    <headerContent>
      <Button text="編集" icon="sap-icon://edit" visible="{= !${detail>/isNew} &amp;&amp; !${detail>/editable} }" press=".onEdit" />
      <Button text="保存" type="Emphasized" icon="sap-icon://save" visible="{= ${detail>/isNew} || ${detail>/editable} }" press=".onSave" />
      <Button text="承認" icon="sap-icon://accept" visible="{= !${detail>/isNew} }" press=".onApprove" />
      <Button text="却下" icon="sap-icon://decline" visible="{= !${detail>/isNew} }" press=".onReject" />
    </headerContent>
    <content>
      <VBox class="sapUiResponsiveContentPadding rmPageContent" renderType="Bare">
        <ObjectHeader
          title="{= ${detail>/isNew} ? '新規申請' : '申請明細' }"
          intro="{detail>/request/content}"
          number="{detail>/request/requestNo}"
          class="sapUiSmallMarginBottom" />
        <Panel headerText="申請情報" class="sapUiMediumMarginBottom">
          <f:SimpleForm
            class="rmDetailForm"
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanXL="3"
            labelSpanL="3"
            labelSpanM="3"
            adjustLabelSpan="false">
            <f:content>
              <Label text="申請番号" required="true" />
              <Input value="{detail>/request/requestNo}" editable="{= ${detail>/isNew} || ${detail>/editable} }" />

              <Label text="ステータス" required="true" />
              <Select selectedKey="{detail>/request/status}" enabled="{= ${detail>/isNew} || ${detail>/editable} }">
                <core:Item key="00" text="新規" />
                <core:Item key="01" text="承認済" />
                <core:Item key="02" text="却下" />
              </Select>

              <Label text="申請内容" required="true" />
              <TextArea value="{detail>/request/content}" rows="4" editable="{= ${detail>/isNew} || ${detail>/editable} }" />

              <Label text="申請者" required="true" />
              <Input value="{detail>/request/applicant}" editable="{= ${detail>/isNew} || ${detail>/editable} }" />

              <Label text="承認者" />
              <Input value="{detail>/request/approver}" editable="false" placeholder="保存時に既定承認者を設定" />
            </f:content>
          </f:SimpleForm>
        </Panel>
      </VBox>
    </content>
  </Page>
</mvc:View>
