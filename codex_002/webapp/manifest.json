{
  "_version": "1.65.0",
  "sap.app": {
    "id": "request.management",
    "type": "application",
    "title": "申請管理",
    "description": "Fiori based request management mock application",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "request.management.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": false
    },
    "models": {},
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "request.management.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "name": "list",
          "pattern": "",
          "target": "list"
        },
        {
          "name": "detail",
          "pattern": "detail/{requestId}",
          "target": "detail"
        },
        {
          "name": "new",
          "pattern": "new",
          "target": "detail"
        }
      ],
      "targets": {
        "list": {
          "viewName": "List",
          "viewId": "list"
        },
        "detail": {
          "viewName": "Detail",
          "viewId": "detail"
        }
      }
    }
  }
}
